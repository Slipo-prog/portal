from news.models import Author, Category, Post, PostCategory, Comment
from django.contrib.auth.models import User

# 1. Создать двух пользователей
user1 = User.objects.create_user('user1')
user2 = User.objects.create_user('user2')

# 2. Создать два объекта Author
author1 = Author.objects.create(user=user1)
author2 = Author.objects.create(user=user2)

# 3. Добавить 4 категории
cat_sport = Category.objects.create(name='Спорт')
cat_polit = Category.objects.create(name='Политика')
cat_edu = Category.objects.create(name='Образование')
cat_tech = Category.objects.create(name='Технологии')

# 4. Добавить 2 статьи и 1 новость
post1 = Post.objects.create(author=author1, post_type='AR', title='Статья 1', text='Текст первой статьи. ' * 20)
post2 = Post.objects.create(author=author2, post_type='AR', title='Статья 2', text='Текст второй статьи. ' * 20)
post3 = Post.objects.create(author=author1, post_type='NE', title='Новость 1', text='Текст новости. ' * 20)

# 5. Присвоить категории
PostCategory.objects.create(post=post1, category=cat_sport)
PostCategory.objects.create(post=post1, category=cat_polit)
PostCategory.objects.create(post=post2, category=cat_edu)
PostCategory.objects.create(post=post3, category=cat_tech)

# 6. Создать комментарии
comment1 = Comment.objects.create(post=post1, user=user2, text='Комментарий к статье 1')
comment2 = Comment.objects.create(post=post2, user=user1, text='Комментарий к статье 2')
comment3 = Comment.objects.create(post=post3, user=user2, text='Комментарий к новости')
comment4 = Comment.objects.create(post=post1, user=user1, text='Ещё комментарий к статье 1')

# 7. Лайки и дизлайки
post1.like()
post1.like()
post2.like()
post3.dislike()
comment1.like()
comment2.like()
comment3.dislike()
comment4.like()

# 8. Обновить рейтинг авторов
author1.update_rating()
author2.update_rating()

# 9. Лучший пользователь
best_author = Author.objects.order_by('-rating').first()
print(best_author.user.username, best_author.rating)

# 10. Лучшая статья
best_post = Post.objects.order_by('-rating').first()
print(best_post.created_at, best_post.author.user.username, best_post.rating, best_post.title, best_post.preview())

# 11. Все комментарии к лучшей статье
best_comments = Comment.objects.filter(post=best_post)
for comment in best_comments:
    print(comment.created_at, comment.user.username, comment.rating, comment.text)
